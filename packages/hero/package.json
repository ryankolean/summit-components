{
  "name": "@summit/hero",
  "version": "0.2.0",
  "description": "Page hero: React component, HTML renderer and a no-build custom element with identical markup",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html": {
      "source": "./src/html.ts",
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./embed": {
      "source": "./src/embed.ts",
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./hero.css": "./src/hero.css"
  },
  "files": [
    "dist",
    "src/hero.css"
  ],
  "sideEffects": [
    "./dist/embed.js",
    "./src/embed.ts",
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example": "node example/build.mjs"
  },
  "dependencies": {
    "@summit/schemas": "workspace:^",
    "zod": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@summit/tokens": "workspace:^"
  }
}
