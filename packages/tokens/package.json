{
  "name": "@summit/tokens",
  "version": "0.1.1",
  "description": "Brand tokens as CSS custom properties and a Tailwind preset, with a WCAG contrast guard",
  "type": "module",
  "bin": {
    "summit-tokens": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@summit/schemas": "workspace:^"
  }
}
