{
  "name": "@summit/cli",
  "version": "0.1.0",
  "description": "The summit command: intake, client repo bootstrap, preview pages and site checks",
  "type": "module",
  "bin": {
    "summit": "./dist/summit.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs"
  },
  "devDependencies": {
    "@summit/checks": "workspace:^",
    "@summit/hero": "workspace:^",
    "@summit/schemas": "workspace:^",
    "@summit/seo": "workspace:^",
    "@summit/tokens": "workspace:^",
    "esbuild": "^0.28.2",
    "node-html-parser": "^7.0.1"
  }
}
