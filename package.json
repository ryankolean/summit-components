{
  "name": "summit-components",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "templates:verify": "node scripts/verify-templates.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "registry:check": "node scripts/check-registry.mjs",
    "example": "pnpm --filter @summit/hero example",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-registry.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@summit/checks": "workspace:*",
    "@summit/cli": "workspace:*",
    "@summit/hero": "workspace:*",
    "@summit/schemas": "workspace:*",
    "@summit/seo": "workspace:*",
    "@summit/tokens": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "happy-dom": "^18.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
